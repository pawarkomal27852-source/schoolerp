# ── Server ────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database ──────────────────────────────────────────────────────────────
# MongoDB Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net/schoolerp
# Local MongoDB:  mongodb://localhost:27017/schoolerp
MONGODB_URI=

# ── Authentication ────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ── CORS ──────────────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
